<%- include("partials/header.ejs") %>

<main class="write">
  <h2 class="write-heading">Edit your blog</h2>

  <form
    action="/edit/<%= post.id %>"
    method="POST"
    enctype="multipart/form-data"
    class="write-form"
  >
    <div class="field">
      <label for="author">Name:</label>
      <input
        type="text"
        id="author"
        name="author"
        value="<%= post.author %>"
        required
      />
    </div>

    <div class="field">
      <label for="title">Title:</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= post.title %>"
        required
      />
    </div>

    <label for="text" class="block-label">Write your blog:</label>
    <textarea id="text" name="text" required><%= post.text %></textarea>

    <% if (post.img) { %>
    <img
      class="current-img"
      src="/images/<%= post.img %>"
      alt="Current picture"
    />
    <% } %>

    <div class="field upload">
      <label for="img">Change picture (optional):</label>
      <input type="file" id="img" name="img" accept="image/*" />
    </div>

    <button type="submit" class="submit-btn">Save changes</button>
  </form>
</main>

<%- include("partials/footer.ejs") %>